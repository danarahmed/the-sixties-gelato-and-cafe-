# ---------------------------------------------------------------------------
# The Sixty's — Books. Server-side configuration.
# Copy to .env.local for local development; set the same keys in the Vercel
# project settings for the deployment. Never commit real values.
# ---------------------------------------------------------------------------

# Claude API key for the assisted bookkeeping (expense classification and the
# period-close review). WITHOUT this the app still works end to end — it falls
# back to deterministic house rules and says so in the interface.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5. Use claude-haiku-4-5 for a cheaper,
# faster classifier if the volume of expenses ever justifies it.
ANTHROPIC_MODEL=

# Supabase. The app ships with the public anon key and URL as committed
# fallbacks, so these are only needed to point at a different project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
