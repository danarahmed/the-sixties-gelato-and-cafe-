# =============================================================================
# The Sixty's Gelato & Café — environment template
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# =============================================================================

# --- Supabase (PostgreSQL, Auth, Storage, RLS) -------------------------------
# Create a project at https://supabase.com (or run `supabase start` locally).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Grants elevated access; keep it out of client code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (migrations / server jobs). Local default shown.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Business defaults (also configurable in-app under Settings) -------------
DEFAULT_CURRENCY=IQD
DEFAULT_CURRENCY_DECIMALS=0
DEFAULT_TIMEZONE=Asia/Baghdad
DEFAULT_LOCALE=en           # en | ar | ckb

# --- AI provider (OPTIONAL — the app runs fully without any of these) --------
# Leave AI_PROVIDER empty to disable all AI features.
AI_PROVIDER=                # anthropic | openai | (empty = disabled)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=                   # e.g. claude-sonnet-5 ; provider default if empty

# --- Delivery platforms (OPTIONAL) -------------------------------------------
# Talabat Partner API credentials are issued after partner approval. Until then
# the CSV import + mock adapter are used. See docs/guides/talabat.md.
TALABAT_API_BASE_URL=
TALABAT_API_KEY=
TALABAT_STORE_ID=
