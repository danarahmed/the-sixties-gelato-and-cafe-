{
  "name": "sixties-gelato-cafe",
  "version": "0.1.0",
  "private": true,
  "description": "Business-management system for The Sixty's Gelato & Café — POS, inventory ledger, production, purchasing, delivery-platform reconciliation, management accounting, and AI insights.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:reset": "supabase db reset",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
